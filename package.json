{
  "name": "quadrate-notes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "pnpm --filter @qnotes/web dev",
    "build": "pnpm -r build && pnpm run verify:edge-shared",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm --filter @qnotes/markdown test && pnpm --filter @qnotes/sync test && pnpm --filter @qnotes/api-client test && pnpm --filter @qnotes/cli test",
    "test:e2e": "playwright test",
    "local:env": "node scripts/write-local-env.mjs",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "db:types": "pnpm exec supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "sync:edge": "node scripts/sync-edge-shared.mjs",
    "verify:edge-shared": "node scripts/verify-edge-shared.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@supabase/supabase-js": "2.56.0",
    "@types/node": "24.3.0",
    "supabase": "2.116.0",
    "typescript": "5.9.2"
  }
}
