{
  "name": "quadrate-notes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "pnpm --filter @qnotes/web dev",
    "build": "pnpm -r build && pnpm run verify:edge-shared",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "node --test scripts/test/*.test.mjs && pnpm --filter @qnotes/shared test && pnpm --filter @qnotes/markdown test && pnpm --filter @qnotes/sync test && pnpm --filter @qnotes/api-client test && pnpm --filter @qnotes/cli test && pnpm --filter @qnotes/mcp-server test",
    "test:edge": "node scripts/test-edge.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "test:mcp": "pnpm --filter @qnotes/mcp-server test",
    "evaluate:search": "node scripts/evaluate-search.mjs",
    "benchmark:seed": "node scripts/seed-search-benchmark.mjs",
    "benchmark:search": "node scripts/search-benchmark.mjs",
    "verify:search": "node scripts/verify-search-regression.mjs",
    "test:e2e": "playwright test",
    "local:env": "node scripts/write-local-env.mjs",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "db:types": "pnpm exec supabase gen types typescript --local --schema notesdb,public > packages/shared/src/database.types.ts",
    "sync:edge": "node scripts/sync-edge-shared.mjs",
    "verify:edge-shared": "node scripts/verify-edge-shared.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@supabase/supabase-js": "2.56.0",
    "@types/node": "24.3.0",
    "supabase": "2.116.0",
    "typescript": "5.9.2"
  },
  "workspaces": ["apps/*", "packages/*"]
}
